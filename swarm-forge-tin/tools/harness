#!/usr/bin/env python3
"""harness -- wiring status and cleanup for the swarm-forge-tin pack.

Usage:
  harness config            print resolved wiring as JSON
  harness status            print resolved paths and existence
  harness clean [TARGET]    clean hot (default), state, artifacts, or all
"""

import argparse
import json
import shutil
import sys
from pathlib import Path

import wiring


def _clean_dir(path):
    removed = 0
    if not path.is_dir():
        path.mkdir(parents=True, exist_ok=True)
        return removed
    for child in path.iterdir():
        if child.is_dir() and not child.is_symlink():
            shutil.rmtree(child)
        else:
            child.unlink()
        removed += 1
    return removed


def _in_process_count(state_root):
    count = 0
    mail = state_root / "mail" / "inbox"
    if mail.is_dir():
        count += len(list(mail.glob("*/in_process/*.json")))
    tasks = state_root / "tasks"
    if tasks.is_dir():
        count += len(list(tasks.glob("**/task.json")))
    return count


def cmd_config(args):
    resolved = wiring.load(config=args.config, start=args.workspace).as_dict()
    print(json.dumps(resolved, indent=2))
    return 0


def cmd_status(args):
    resolved = wiring.load(config=args.config, start=args.workspace)
    rows = [
        ("PACK", resolved.pack_root),
        ("CONFIG", resolved.config_path),
        ("WORKSPACE", resolved.workspace_root),
        ("STATE", resolved.state_root),
        ("ARTIFACTS", resolved.artifacts_root),
        ("HOT", resolved.hot_tests),
    ]
    for label, path in rows:
        marker = "ok" if path and Path(path).exists() else "-"
        print(f"{label:<10} [{marker}] {path if path else '(none)'}")
    for entry in resolved.persistent_tests:
        marker = "ok" if entry["root"].exists() else "-"
        print(f"PERSIST    [{marker}] {entry['root']} ({entry['kind']})")
    return 0


def cmd_clean(args):
    resolved = wiring.load(config=args.config, start=args.workspace)
    targets = []
    if args.target in ("hot", "all"):
        targets.append(("hot", resolved.hot_tests))
    if args.target in ("artifacts", "all"):
        targets.append(("artifacts", resolved.artifacts_root))
    if args.target in ("state", "all"):
        held = _in_process_count(resolved.state_root)
        if held and not args.force:
            print(
                f"harness: {held} in-process item(s) under {resolved.state_root}; "
                "use --force to clean anyway",
                file=sys.stderr,
            )
            return 2
        targets.append(("state", resolved.state_root))
    for label, path in targets:
        removed = _clean_dir(path)
        print(f"CLEANED {label}: {path} ({removed} entr{'y' if removed == 1 else 'ies'})")
    return 0


def build_parser():
    parser = argparse.ArgumentParser(prog="harness")
    parser.add_argument("--config")
    parser.add_argument("--workspace")
    sub = parser.add_subparsers(dest="command", required=True)

    config_cmd = sub.add_parser("config")
    config_cmd.set_defaults(func=cmd_config)

    status = sub.add_parser("status")
    status.set_defaults(func=cmd_status)

    clean = sub.add_parser("clean")
    clean.add_argument(
        "target",
        nargs="?",
        choices=("hot", "state", "artifacts", "all"),
        default="hot",
    )
    clean.add_argument("--force", action="store_true")
    clean.set_defaults(func=cmd_clean)

    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except wiring.WiringError as error:
        print(f"harness: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
