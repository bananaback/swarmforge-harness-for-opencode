#!/usr/bin/env python3
"""ruff4py -- Python code-quality check for the pack.

Thin wrapper over `ruff check`. Keeps the cache under the wiring artifacts
root so no .ruff_cache appears in the project tree, defaults to the pack's
ruff.toml, and passes all other arguments through to ruff unchanged.
"""

import os
import shutil
import subprocess
import sys
from pathlib import Path

import wiring


def usage():
    print(
        "usage: ruff4py [ruff check arguments...]\n"
        "\n"
        "Wrapper around `ruff check`. Runs:\n"
        "  ruff check --cache-dir <artifacts>/ruff-cache --config <config> <args>\n"
        "\n"
        "`check` is supplied automatically; pass only paths and options.\n"
        "Set RUFF4PY_CONFIG to override the config file (default: pack ruff.toml)."
    )


def main():
    raw_args = sys.argv[1:]
    if "-h" in raw_args or "--help" in raw_args:
        usage()
        return 0
    if "check" in raw_args:
        print(
            "ruff4py: `check` is already supplied; run `ruff4py <paths>`",
            file=sys.stderr,
        )
        return 2
    ruff = shutil.which("ruff")
    if ruff is None:
        print("ruff4py: ruff is not installed or not on PATH", file=sys.stderr)
        return 2
    resolved = wiring.load()
    command = [ruff, "check"]
    if "--cache-dir" not in raw_args:
        cache_dir = resolved.artifacts_root / "ruff-cache"
        cache_dir.mkdir(parents=True, exist_ok=True)
        command += ["--cache-dir", str(cache_dir)]
    if "--config" not in raw_args:
        override = os.environ.get("RUFF4PY_CONFIG")
        config = (
            Path(override).expanduser()
            if override
            else resolved.pack_root / "ruff.toml"
        )
        command += ["--config", str(config)]
    command += raw_args
    return subprocess.call(command)


if __name__ == "__main__":
    sys.exit(main())
