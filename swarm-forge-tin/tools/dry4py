#!/usr/bin/env python3
"""dry4py -- duplicate-code report for Python projects via jscpd.

Thin wrapper over jscpd with fixed defaults. Writes the JSON report under
swarm-forge-tin/dump/dry4py/ and prints a compact clone list with file and
line ranges. Report-only by default, mirroring dry4clj.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

DEFAULT_REPORT_DIR = Path(__file__).resolve().parent.parent / "dump" / "dry4py"
DEFAULT_IGNORES = [
    "**/.venv/**",
    "**/venv/**",
    "**/node_modules/**",
    "**/__pycache__/**",
    "**/tmp/**",
    "**/build/**",
    "**/dist/**",
]


def parse_args(argv):
    parser = argparse.ArgumentParser(
        prog="dry4py",
        description="Duplicate-code report for Python projects (jscpd).",
    )
    parser.add_argument(
        "paths",
        nargs="*",
        help="files or directories to scan (default: src)",
    )
    parser.add_argument(
        "--min-lines",
        type=int,
        default=4,
        help="minimum clone size in lines (default: 4)",
    )
    parser.add_argument(
        "--mode",
        choices=["strict", "mild", "weak"],
        default="weak",
        help="token comparison mode (default: weak)",
    )
    parser.add_argument(
        "--report",
        default=str(DEFAULT_REPORT_DIR / "jscpd-report.json"),
        help="JSON report path",
    )
    parser.add_argument(
        "--fail-on-duplicates",
        action="store_true",
        help="exit 2 when duplicates are found (default: report-only)",
    )
    parser.add_argument(
        "--ignore",
        action="append",
        default=[],
        help="additional glob to ignore; repeatable",
    )
    return parser.parse_args(argv)


def display_path(root, name):
    if root in ("", "."):
        return name
    if os.path.isabs(name) or name.startswith(root + os.sep):
        return name
    return os.path.join(root, name)


def main(argv):
    args = parse_args(argv)
    paths = args.paths or ["src"]
    if shutil.which("jscpd") is None:
        print(
            "dry4py: jscpd not found on PATH; install with: npm install -g jscpd@5",
            file=sys.stderr,
        )
        return 1
    report = Path(args.report).resolve()
    report.parent.mkdir(parents=True, exist_ok=True)
    command = [
        "jscpd",
        "--format",
        "python",
        "--min-lines",
        str(args.min_lines),
        "--mode",
        args.mode,
        "--reporters",
        "json",
        "--output",
        str(report.parent),
        "--workers",
        "4",
        "--silent",
    ]
    for pattern in DEFAULT_IGNORES + args.ignore:
        command.extend(["--ignore", pattern])
    command.extend(paths)
    proc = subprocess.run(command)
    if proc.returncode not in (0, 1):
        print(f"dry4py: jscpd failed (exit {proc.returncode})", file=sys.stderr)
        return 1
    generated = report.parent / "jscpd-report.json"
    if not generated.exists():
        print(f"dry4py: jscpd did not write {generated}", file=sys.stderr)
        return 1
    if generated != report:
        shutil.copyfile(generated, report)
    data = json.loads(report.read_text())
    duplicates = data.get("duplicates", [])
    prefix = paths[0] if len(paths) == 1 and os.path.isdir(paths[0]) else None
    if not duplicates:
        print("No duplicate candidates found.")
        print(f"JSON report: {report}")
        return 0
    for clone in duplicates:
        first = clone["firstFile"]
        second = clone["secondFile"]
        print(f"DUPLICATE lines={clone.get('lines')} tokens={clone.get('tokens')}")
        print(f"  {display_path(prefix, first['name'])}:{first['start']}-{first['end']}")
        print(
            f"  {display_path(prefix, second['name'])}:{second['start']}-{second['end']}"
        )
        print()
    total = data.get("statistics", {}).get("total", {})
    print(
        f"Found {len(duplicates)} duplicate candidate(s); "
        f"{total.get('duplicatedLines', '?')} duplicated lines "
        f"({total.get('percentage', 0):.2f}%)"
    )
    print(f"JSON report: {report}")
    if args.fail_on_duplicates:
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
